@{
    Layout = "_Layout";
    ViewBag.Titulo = "Início";
}

<div class="row g-4 pb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 glass-card">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary fw-bold">Instrutores</h5>
                <p class="card-text text-body-secondary">Cadastre os instrutores da escola</p>
                <a class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" asp-controller="Instrutor" asp-action="Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 glass-card">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary fw-bold">Alunos</h5>
                <p class="card-text text-body-secondary">Gerencie o cadastro de alunos</p>
                <a class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" asp-controller="Aluno" asp-action="Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 glass-card">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary fw-bold">Cursos</h5>
                <p class="card-text text-body-secondary">Gerencie o cadastro de cursos</p>
                <a class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" asp-controller="Curso" asp-action="Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 glass-card">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary fw-bold">Turmas</h5>
                <p class="card-text text-body-secondary">Gerencie as turmas</p>
                <a class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" asp-controller="Turma" asp-action="Listar">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card h-100 glass-card">
            <div class="card-body text-center p-4">
                <h5 class="card-title text-primary fw-bold">Matrículas</h5>
                <p class="card-text text-body-secondary">Gerencie as matrículas dos alunos</p>
                <a class="btn btn-primary rounded-pill px-4 mt-2 shadow-sm" asp-controller="Matricula" asp-action="Listar">Acessar</a>
            </div>
        </div>
    </div>
</div>